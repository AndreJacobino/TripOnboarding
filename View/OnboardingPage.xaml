<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TripOnboarding.View.OnboardingPage"
             xmlns:models="clr-namespace:TripOnboarding.Models"
             xmlns:viewmodels="clr-namespace:TripOnboarding.VIewModels"
             BackgroundColor="#FFFFFF"
             Shell.NavBarIsVisible="False"
             Title="OnboardingPage">

    <Grid RowDefinitions="*, Auto, Auto" 
          Padding="24,20,24,30" 
          RowSpacing="15">

        <!-- Carrossel de Itens -->
        <CarouselView Grid.Row="0"
                      Position="{Binding Posicao}"
                      IndicatorView="Indicador"
                      Loop="False"
                      ItemsSource="{Binding Itens}">

            <CarouselView.ItemTemplate>
                <DataTemplate x:DataType="models:OnboardingItem">
                    <Grid RowDefinitions="*, Auto, Auto" RowSpacing="15">

                        <!-- 1. Imagem no Topo -->
                        <Image Grid.Row="0"
                               Source="{Binding ImagemUrl}"
                               Aspect="AspectFit"
                               HorizontalOptions="Center"
                               VerticalOptions="Center" />

                        <!-- 2. Título no Meio -->
                        <Label Grid.Row="1"
                               Text="{Binding Titulo}"
                               FontSize="24"
                               FontAttributes="Bold"
                               TextColor="#1A1A1A"
                               HorizontalTextAlignment="Center" />

                        <!-- 3. Descrição Abaixo -->
                        <Label Grid.Row="2"
                               Text="{Binding Descricao}"
                               FontSize="14"
                               TextColor="#666666"
                               HorizontalTextAlignment="Center"
                               Margin="10,0" />
                    </Grid>
                </DataTemplate>
            </CarouselView.ItemTemplate>
        </CarouselView>

        <!-- Indicador de Páginas (Bolinhas) -->
        <IndicatorView x:Name="Indicador"
                       Grid.Row="1"
                       HorizontalOptions="Center"
                       IndicatorColor="#E0E0E0"
                       SelectedIndicatorColor="#FF2B66"
                       IndicatorSize="8"
                       Margin="0,10,0,20" />

        <!-- Botões de Ação -->
        <Grid Grid.Row="2"
              ColumnDefinitions="*,*"
              ColumnSpacing="15">

            <Button Grid.Column="0"
                    Text="Get started"
                    BackgroundColor="#FF2B66"
                    TextColor="White"
                    FontAttributes="Bold"
                    CornerRadius="12"
                    HeightRequest="50" />

            <Button Grid.Column="1"
                    Command="{Binding proximoCommand}"
                    Text="Next"
                    BackgroundColor="#43A047"
                    TextColor="White"
                    FontAttributes="Bold"
                    CornerRadius="12"
                    HeightRequest="50"
                    IsVisible="{Binding ExibirBotao}" />
        </Grid>
    </Grid>

</ContentPage>